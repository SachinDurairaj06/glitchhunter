; Engine configuration file.
; Hangar 9: a Godot 4 test level for GlitchHunter (native engine, driven over the bridge).

config_version=5

[application]

config/name="Hangar 9"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GlitchHunter="*res://glitchhunter_bridge.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/resizable=false
window/stretch/mode="disabled"
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
